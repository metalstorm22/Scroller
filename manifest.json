{
  "manifest_version": 3,
  "name": "Scroller — Keyframe Page Scrolls",
  "version": "0.3.0",
  "description": "Create and replay smooth, timed scroll sequences for polished website recordings.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle Scroller",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "add-keyframe": {
      "suggested_key": "Alt+Shift+K",
      "description": "Capture the current scroll position"
    },
    "play-sequence": {
      "suggested_key": "Alt+Shift+P",
      "description": "Play or stop the current scroll sequence"
    }
  }
}
